{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Nexora Documentation",
  "description": "Build production Paper plugins with editable JavaScript workspaces, safe automatic reload, GUIs, events, persistence, HTTP, and capability-gated APIs.",
  "colors": {
    "primary": "#08756E",
    "light": "#57E0D2",
    "dark": "#08756E"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Space Grotesk",
    "heading": {
      "family": "Space Grotesk",
      "weight": 700
    },
    "body": {
      "family": "Space Grotesk",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#F5F9FA",
      "dark": "#090D12"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "banner": {
    "content": "⚡ Nexora 1.0.0 · Paper 1.21.8 · Java 21+ · JavaScript · automatic safe reload",
    "dismissible": true,
    "type": "info",
    "color": {
      "light": "#0E948B",
      "dark": "#57E0D2"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "🇹🇭 ไทย",
          "href": "/th/"
        },
        {
          "anchor": "🇸🇰 Slovenčina",
          "href": "/sk/"
        },
        {
          "anchor": "🇱🇹 Lietuvių",
          "href": "/lt/"
        }
      ]
    },
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
